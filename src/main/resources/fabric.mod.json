{
	"schemaVersion": 1,
	"id": "mcqol",
	"version": "${version}",
	"name": "zusmori's mcQoL",
	"description": "Quality-of-Life-Mod: Spear Swap, Auto-Elytra, Low Fire, kleines Totem, kein Nebel, klare Sicht unter Wasser, keine Abbau-Risse und kein Kamerawackeln.",
	"authors": [
		"zusmori"
	],
	"license": "MIT",
	"icon": "assets/mcqol/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.zusmori.mcqol.McQoLClient"
		],
		"modmenu": [
			"de.zusmori.mcqol.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "mcqol.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
